# Copy these into Vercel → Project → Settings → Environment Variables.
# Never commit real values: this repo is public.

# Supabase POOLED connection string (port 6543, not 5432).
# Serverless opens many short-lived connections and will exhaust the direct limit.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Shared secret with the kiosk. Must match the kiosk's SYNC_TOKEN exactly.
SYNC_TOKEN=

# bcrypt hash of the password used to log in to this site.
# NOT the kiosk admin password — that one gets typed on a public screen.
APP_PASSWORD_HASH=

# Random string signing the login cookie.
SESSION_SECRET=
